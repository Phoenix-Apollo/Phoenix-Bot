# Discord bot token (required)
TOKEN=your_discord_bot_token_here

# Optional future AI settings
AI_ENABLED=false
AI_PROVIDER=NONE
AI_API_KEY=

# Data store + refresh policy
SC_DB_PATH=data/starcitizen.db
SC_REFRESH_INTERVAL_MINUTES=43200
SC_FORCE_REFRESH=false
BOT_AUTONOMOUS_LEARNING_ENABLED=true
BOT_PASSIVE_LEARNING_ALL_GUILD_MESSAGES=true
BOT_AUTO_PERSONAL_PHRASE_LEARNING_ENABLED=true
BOT_PASSIVE_HISTORY_BACKFILL_ENABLED=true
BOT_PASSIVE_HISTORY_BACKFILL_MESSAGES_PER_CHANNEL=60
BOT_PASSIVE_HISTORY_BACKFILL_MAX_CHANNELS_PER_GUILD=10
BOT_PASSIVE_HISTORY_BACKFILL_MAX_AGE_DAYS=14
BOT_PASSIVE_HISTORY_BACKFILL_AI_SCOPE_ONLY=true

# Optional local-first dataset file overrides (raw game/export payloads)
# SC_SHIPS_FILE=data/game/ships.json
# SC_SHIPS_STATS_FILE=data/game/ships_stats.json
# SC_SHIPS_STATS_HTML_URL=https://www.erkul.games/live/ships
# SC_WEAPONS_FILE=data/game/weapons.json
# SC_WEAPONS_STATS_FILE=data/game/weapons_stats.json
# SC_WEAPONS_STATS_URL=https://api.erkul.games/live/weapon
# SC_WEAPONS_STATS_HTML_URL=https://www.erkul.games/live/weapons
# SC_COMPONENTS_FILE=data/game/components.json
# SC_COMPONENTS_STATS_FILE=data/game/components_stats.json
# SC_COMMODITIES_FILE=data/game/commodities.json
# SC_TRADE_ROUTES_FILE=data/game/trade_routes.json
# SC_MINING_FILE=data/game/mining.json
# SC_REFINERY_FILE=data/game/refinery.json
# SC_REFINERY_STATIONS_FILE=data/game/refinery_stations.json
# SC_SALVAGE_FILE=data/game/salvage.json
# SC_LOCATIONS_FILE=data/game/locations.json

# Panel channel configuration (either works)
# PANEL_CHANNEL_IDS=123456789012345678,234567890123456789
# PANEL_DEFAULT_CHANNEL_ID=123456789012345678

# ============================================================================
# SECURITY HARDENING - DATA ENCRYPTION
# ============================================================================

# Enable/disable database encryption (default: true for security)
DB_ENCRYPTION_ENABLED=true

# Database encryption key (if not set, auto-generated and stored in data/keys/master.key)
# For production, set this via secure secrets manager (Vault, AWS Secrets Manager, etc.)
# Never commit this to version control!
# DB_ENCRYPTION_KEY=your_base64_encoded_256bit_aes_key

# Key rotation interval (days, default: 90)
DB_KEY_ROTATION_INTERVAL_DAYS=90

# ============================================================================
# DATA RETENTION & PRIVACY (GDPR Compliance)
# ============================================================================

# Number of days to retain conversation history (default: 60)
BOT_DATA_RETENTION_DAYS=60

# Enable automatic data archival before purge (default: false)
BOT_ARCHIVE_ENABLED=false

# Path for archived data (only if archival is enabled)
BOT_ARCHIVE_PATH=data/archive/

# Hour (0-23 UTC) when automatic cleanup runs (default: 2 = 2 AM UTC)
BOT_RETENTION_CLEANUP_HOUR=2

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================

# Enable automated backups (default: true)
BOT_BACKUP_ENABLED=true

# Hour (0-23 UTC) when automated backup runs (default: 3 = 3 AM UTC)
BOT_BACKUP_HOUR=3

# Enable cloud backup (S3 or GCS)
BOT_CLOUD_BACKUP_ENABLED=false

# Cloud backup provider: "s3" or "gcs" (default: s3)
BOT_CLOUD_BACKUP_PROVIDER=s3

# AWS S3 Configuration (for cloud backups)
# BOT_S3_BUCKET=your-backup-bucket
# BOT_S3_REGION=us-east-1
# AWS credentials should use IAM role or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars

# Google Cloud Storage Configuration (for cloud backups)
# BOT_GCS_BUCKET=your-backup-bucket
# BOT_GCS_PROJECT_ID=your-project-id
# GCS credentials should use GOOGLE_APPLICATION_CREDENTIALS env var pointing to service account JSON

# ============================================================================
# SECRETS MANAGEMENT & TOKEN PROTECTION
# ============================================================================

# Redact secrets from all log output (default: true)
BOT_REDACT_SECRETS_FROM_LOGS=true

# Token rotation check interval (minutes, default: 1440 = daily)
BOT_TOKEN_ROTATION_CHECK_INTERVAL_MINUTES=1440

# Enable admin action confirmation for destructive operations (default: true)
BOT_REQUIRE_ADMIN_CONFIRMATION=true

# ============================================================================
# RATE LIMITING & INPUT VALIDATION
# ============================================================================

# Commands per user per minute (0 = unlimited, default: 30)
BOT_RATE_LIMIT_PER_USER=30

# Commands per guild per minute (0 = unlimited, default: 100)
BOT_RATE_LIMIT_PER_GUILD=100

# Maximum input message length in characters (default: 4000)
BOT_MAX_INPUT_LENGTH=4000

# Enable input validation checks (SQL injection, XSS prevention)
BOT_INPUT_VALIDATION_ENABLED=true

