# Discord bot token (required)
TOKEN=your_discord_bot_token_here

# Optional future AI settings
AI_ENABLED=false
AI_PROVIDER=NONE
AI_API_KEY=

# Data store + refresh policy
SC_DB_PATH=data/starcitizen.db
SC_REFRESH_INTERVAL_MINUTES=43200
SC_FORCE_REFRESH=false
BOT_AUTONOMOUS_LEARNING_ENABLED=true
BOT_PASSIVE_LEARNING_ALL_GUILD_MESSAGES=true
BOT_AUTO_PERSONAL_PHRASE_LEARNING_ENABLED=true
BOT_PASSIVE_HISTORY_BACKFILL_ENABLED=true
BOT_PASSIVE_HISTORY_BACKFILL_MESSAGES_PER_CHANNEL=60
BOT_PASSIVE_HISTORY_BACKFILL_MAX_CHANNELS_PER_GUILD=10
BOT_PASSIVE_HISTORY_BACKFILL_MAX_AGE_DAYS=14
BOT_PASSIVE_HISTORY_BACKFILL_AI_SCOPE_ONLY=true

# Optional local-first dataset file overrides (raw game/export payloads)
# SC_SHIPS_FILE=data/game/ships.json
# SC_SHIPS_STATS_FILE=data/game/ships_stats.json
# SC_SHIPS_STATS_HTML_URL=https://www.erkul.games/live/ships
# SC_WEAPONS_FILE=data/game/weapons.json
# SC_WEAPONS_STATS_FILE=data/game/weapons_stats.json
# SC_WEAPONS_STATS_URL=https://api.erkul.games/live/weapon
# SC_WEAPONS_STATS_HTML_URL=https://www.erkul.games/live/weapons
# SC_COMPONENTS_FILE=data/game/components.json
# SC_COMPONENTS_STATS_FILE=data/game/components_stats.json
# SC_COMMODITIES_FILE=data/game/commodities.json
# SC_TRADE_ROUTES_FILE=data/game/trade_routes.json
# SC_MINING_FILE=data/game/mining.json
# SC_REFINERY_FILE=data/game/refinery.json
# SC_REFINERY_STATIONS_FILE=data/game/refinery_stations.json
# SC_SALVAGE_FILE=data/game/salvage.json
# SC_LOCATIONS_FILE=data/game/locations.json

# Panel channel configuration (either works)
# PANEL_CHANNEL_IDS=123456789012345678,234567890123456789
# PANEL_DEFAULT_CHANNEL_ID=123456789012345678

